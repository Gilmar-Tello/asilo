<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Familiares responsables</h2>
  {{#if (puede 'familiares:crear')}}
    <a href="/familiares/crear" class="btn btn-primary">+ Nuevo familiar</a>
  {{/if}}
</div>

{{#if mensaje}}
  <div class="alert alert-{{tipo}}">{{mensaje}}</div>
{{/if}}

<form class="row g-2 mb-4" action="/familiares" method="GET">
  <div class="col-12 col-md-6">
    <input type="text" name="busqueda" class="form-control"
           placeholder="Buscar por nombre, DPI o correo"
           value="{{busqueda}}">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
  </div>
  {{#if busqueda}}
    <div class="col-auto">
      <a href="/familiares" class="btn btn-outline-secondary">Limpiar</a>
    </div>
  {{/if}}
</form>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Nombre completo</th>
        <th>DPI</th>
        <th>Teléfono</th>
        <th>Correo</th>
        <th>Saldo pendiente</th>
        <th>Internos</th>
        <th>Estado</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each lista}}
        <tr>
          <td>{{nombre_completo}}</td>
          <td>{{dpi}}</td>
          <td>{{telefono}}</td>
          <td>{{correo_electronico}}</td>
          <td>Q {{saldo_pendiente}}</td>
          <td>{{internos_activos}}</td>
          <td>
            {{#if (eq estado 1)}}
              <span class="badge text-bg-success">Activo</span>
            {{else}}
              <span class="badge text-bg-secondary">Inactivo</span>
            {{/if}}
          </td>
          <td class="text-end">
            {{#if (puede 'familiares:editar')}}
              <a href="/familiares/editar/{{id_familiar}}"
                 class="btn btn-sm btn-outline-primary">Editar</a>
            {{/if}}

            {{#if (puede 'familiares:cambiar_estado')}}
              <form action="/familiares/estado/{{id_familiar}}" method="POST" class="d-inline"
                    onsubmit="return confirm('¿Seguro que deseas cambiar el estado de este familiar?');">
                {{#if (eq estado 1)}}
                  <button class="btn btn-sm btn-outline-danger">Desactivar</button>
                {{else}}
                  <button class="btn btn-sm btn-outline-success">Activar</button>
                {{/if}}
              </form>
            {{/if}}
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="8" class="text-center text-muted py-4">
            No se encontraron familiares.
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<p class="text-muted small">
  {{lista.length}} familiar(es) encontrado(s). Un familiar desactivado conserva su historial,
  pero deja de ofrecerse al registrar nuevos internos.
</p>