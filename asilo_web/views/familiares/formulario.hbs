<form class="formulario" action="{{accion}}" method="POST">
  <h2>{{tituloForm}}</h2>

  {{#if mensaje}}
    <div class="alert alert-danger">{{mensaje}}</div>
  {{/if}}

  <fieldset>
    <legend>Datos del familiar responsable</legend>

    <div class="fila">
      <div class="grupo">
        <label for="nombre_completo">Nombre completo *</label>
        <input type="text" id="nombre_completo" name="nombre_completo" required
               minlength="3" maxlength="100" value="{{familiarForm.nombre_completo}}">
      </div>
      <div class="grupo">
        <label for="dpi">No. DPI *</label>
        <input type="text" id="dpi" name="dpi" required
               pattern="[0-9]{13}" maxlength="13"
               title="El DPI debe tener exactamente 13 dígitos"
               placeholder="0000000000000" value="{{familiarForm.dpi}}">
      </div>
    </div>

    <div class="fila">
      <div class="grupo">
        <label for="telefono">No. de Teléfono *</label>
        <input type="tel" id="telefono" name="telefono" required
               pattern="[0-9]{8}" maxlength="8"
               title="El teléfono debe tener 8 dígitos"
               placeholder="00000000" value="{{familiarForm.telefono}}">
      </div>
      <div class="grupo">
        <label for="correo_electronico">Correo Electrónico *</label>
        <input type="email" id="correo_electronico" name="correo_electronico" required
               maxlength="100" value="{{familiarForm.correo_electronico}}">
      </div>
    </div>
  </fieldset>

  <button type="submit">Guardar familiar</button>
  <p class="nota"><a href="/familiares">Cancelar y volver a la lista</a></p>
</form>