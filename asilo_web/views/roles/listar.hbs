<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Roles y permisos</h2>
  <a href="/roles/crear" class="btn btn-primary">+ Nuevo rol</a>
</div>

{{#if mensaje}}
  <div class="alert alert-{{tipo}}">{{mensaje}}</div>
{{/if}}

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Rol</th>
        <th>Descripción</th>
        <th>Permisos</th>
        <th>Usuarios</th>
        <th>Estado</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each roles}}
        <tr>
          <td>
            {{etiqueta}}
            {{#if es_sistema}}<span class="badge text-bg-dark ms-1">Sistema</span>{{/if}}
          </td>
          <td>{{descripcion}}</td>
          <td>{{#if es_sistema}}Todos{{else}}{{total_permisos}}{{/if}}</td>
          <td>{{total_usuarios}}</td>
          <td>
            {{#if (eq estado 1)}}
              <span class="badge text-bg-success">Activo</span>
            {{else}}
              <span class="badge text-bg-secondary">Inactivo</span>
            {{/if}}
          </td>
          <td class="text-end">
            {{#if es_sistema}}
              <span class="text-muted small">Protegido</span>
            {{else}}
              <a href="/roles/editar/{{id_rol}}"
                 class="btn btn-sm btn-outline-primary">Editar</a>

              <form action="/roles/estado/{{id_rol}}" method="POST" class="d-inline"
                    onsubmit="return confirm('¿Seguro que deseas cambiar el estado de este rol?');">
                {{#if (eq estado 1)}}
                  <button class="btn btn-sm btn-outline-secondary">Desactivar</button>
                {{else}}
                  <button class="btn btn-sm btn-outline-success">Activar</button>
                {{/if}}
              </form>

              <form action="/roles/eliminar/{{id_rol}}" method="POST" class="d-inline"
                    onsubmit="return confirm('¿Eliminar este rol? Esta acción no se puede deshacer.');">
                <button class="btn btn-sm btn-outline-danger"
                  {{#if total_usuarios}}disabled title="Tiene usuarios asignados; desactívalo en su lugar"{{/if}}>
                  Eliminar
                </button>
              </form>
            {{/if}}
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="6" class="text-center text-muted py-4">No hay roles registrados.</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<p class="text-muted small">
  Un rol desactivado deja de ofrecerse al crear usuarios; quienes ya lo tienen lo conservan.
  Un rol con usuarios asignados no se puede eliminar.
</p>
