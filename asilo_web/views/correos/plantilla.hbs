<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0">{{plantilla.nombre}}</h2>
    <div class="text-muted">Edita el texto que recibe el familiar responsable</div>
  </div>
  <a class="btn btn-outline-secondary btn-sm" href="/correos/plantillas">← Plantillas</a>
</div>

{{#if mensaje}}<div class="alert alert-{{tipo}}">{{mensaje}}</div>{{/if}}

<div class="row g-4">
  <div class="col-12 col-lg-6">
    {{!-- data-sin-mayusculas: una carta en MAYÚSCULAS se lee como si gritara; aquí se respeta lo que se escribe --}}
    <form action="/correos/plantillas/{{plantilla.id_plantilla}}" method="POST">
      <div class="mb-3">
        <label class="form-label">Asunto *</label>
        <input type="text" name="asunto" class="form-control" required minlength="5" maxlength="150" value="{{plantilla.asunto}}" data-sin-mayusculas>
      </div>
      <div class="mb-2">
        <label class="form-label">Mensaje *</label>
        <textarea name="cuerpo" class="form-control" rows="14" required minlength="20" maxlength="5000" data-sin-mayusculas>{{plantilla.cuerpo}}</textarea>
      </div>
      <div class="form-text mb-3">
        Huecos que puedes usar (se llenan solos al enviar): <code>{{plantilla.variables}}</code>
      </div>
      <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" role="switch" id="activa" name="activa" value="1" {{#if plantilla.activa}}checked{{/if}}>
        <label class="form-check-label" for="activa">Enviar este aviso (si lo apagas, este evento no manda correo)</label>
      </div>
      <button class="btn btn-primary">Guardar plantilla</button>
    </form>
  </div>
  <div class="col-12 col-lg-6">
    <div class="small text-muted mb-1">Vista previa con datos de ejemplo (la última versión guardada o la que acabas de enviar):</div>
    <iframe title="Vista previa del correo" srcdoc="{{vistaPrevia}}" class="w-100 border rounded" style="height:520px;background:#f1f5f9"></iframe>
  </div>
</div>
