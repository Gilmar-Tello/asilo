<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0">Ingresar lote</h2>
    <div class="text-muted">{{medicamento.nombre}} {{medicamento.presentacion}} · existencia actual {{medicamento.existencia}} · venta Q {{medicamento.precio}}</div>
  </div>
  <a href="/medicamentos" class="btn btn-outline-secondary">Volver a la lista</a>
</div>

{{#if mensaje}}
  <div class="alert alert-danger">{{mensaje}}</div>
{{/if}}

<div class="card">
  <div class="card-body">
    <form class="row g-3" action="/medicamentos/{{medicamento.id_medicamento}}/ingreso" method="POST">
      <div class="col-6 col-md-2">
        <label for="cantidad" class="form-label">Cantidad *</label>
        <input type="number" class="form-control" id="cantidad" name="cantidad" required min="1" max="99999" step="1" value="{{loteForm.cantidad}}">
      </div>
      <div class="col-6 col-md-3">
        <label for="numero_lote" class="form-label">Número de lote</label>
        <input type="text" class="form-control" id="numero_lote" name="numero_lote" maxlength="40" value="{{loteForm.numero_lote}}">
      </div>
      <div class="col-6 col-md-3">
        <label for="fecha_vencimiento" class="form-label">Fecha de vencimiento *</label>
        <input type="date" class="form-control" id="fecha_vencimiento" name="fecha_vencimiento" required min="{{manana}}" value="{{loteForm.fecha_vencimiento}}">
      </div>
      <div class="col-6 col-md-2">
        <label for="precio_compra" class="form-label">Precio de compra (Q) *</label>
        <input type="number" class="form-control" id="precio_compra" name="precio_compra" required min="0" max="99999.99" step="0.01" value="{{loteForm.precio_compra}}">
        <div class="form-text">Por unidad.</div>
      </div>
      <div class="col-12 col-md-2">
        <label for="proveedor" class="form-label">Proveedor</label>
        <input type="text" class="form-control" id="proveedor" name="proveedor" maxlength="100" value="{{loteForm.proveedor}}">
      </div>
      <div class="col-12">
        <button type="submit" class="btn btn-success">Ingresar lote</button>
      </div>
    </form>
  </div>
</div>
