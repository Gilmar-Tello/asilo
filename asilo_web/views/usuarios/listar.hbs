<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Usuarios</h2>
  {{#if (puede 'usuarios:crear')}}
    <a href="/usuarios/agregar" class="btn btn-primary">+ Nuevo usuario</a>
  {{/if}}
</div>

{{#if mensaje}}
  <div class="alert alert-{{tipo}}">{{mensaje}}</div>
{{/if}}

<form class="row g-2 mb-4" action="/usuarios" method="GET">
  <div class="col-12 col-md-6">
    <input type="text" name="busqueda" class="form-control"
           placeholder="Buscar por nombre, apellido, DPI, usuario o correo"
           value="{{busqueda}}">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
  </div>
  {{#if busqueda}}
    <div class="col-auto">
      <a href="/usuarios" class="btn btn-outline-secondary">Limpiar</a>
    </div>
  {{/if}}
</form>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Nombre completo</th>
        <th>DPI</th>
        <th>Usuario</th>
        <th>Rol</th>
        <th>Estado</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each lista}}
        <tr>
          <td>{{nombre_completo}}</td>
          <td>{{dpi}}</td>
          <td>{{usuario}}</td>
          <td>{{rol_texto}}</td>
          <td>
            {{#if (eq estado 1)}}
              <span class="badge text-bg-success">Activo</span>
            {{else}}
              <span class="badge text-bg-secondary">Inactivo</span>
            {{/if}}
          </td>
          <td class="text-end">
            {{#if editable}}
              {{#if (puede 'usuarios:editar')}}
                <a href="/usuarios/editar/{{id_usuario}}"
                   class="btn btn-sm btn-outline-primary">Editar</a>
              {{/if}}

              {{#if (puede 'usuarios:cambiar_estado')}}
                <form action="/usuarios/estado/{{id_usuario}}" method="POST"
                      class="d-inline"
                      onsubmit="return confirm('¿Seguro que deseas cambiar el estado de este usuario?');">
                  {{#if (eq estado 1)}}
                    <button class="btn btn-sm btn-outline-danger">Desactivar</button>
                  {{else}}
                    <button class="btn btn-sm btn-outline-success">Activar</button>
                  {{/if}}
                </form>
              {{/if}}
            {{else}}
              <span class="text-muted small">Protegido</span>
            {{/if}}
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="6" class="text-center text-muted py-4">
            No se encontraron usuarios.
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<p class="text-muted small">
  {{lista.length}} usuario(s) encontrado(s).
</p>
