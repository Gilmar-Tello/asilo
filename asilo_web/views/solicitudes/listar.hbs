<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">{{#if veTodas}}Solicitudes de referencia{{else}}Mis acompañamientos{{/if}}</h2>
  {{#if puedeCrear}}
    <a href="/solicitudes/crear" class="btn btn-primary">+ Nueva solicitud</a>
  {{/if}}
</div>

{{#if mensaje}}
  <div class="alert alert-{{tipo}}">{{mensaje}}</div>
{{/if}}

{{#if veTodas}}
  <form class="row g-2 mb-4" action="/solicitudes" method="GET">
    <div class="col-12 col-md-4">
      <select name="estado" class="form-select">
        <option value="">Todos los estados</option>
        {{#each estados}}
          <option value="{{this}}" {{#if (eq this ../estado)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    </div>
    {{#if estado}}
      <div class="col-auto">
        <a href="/solicitudes" class="btn btn-outline-secondary">Limpiar</a>
      </div>
    {{/if}}
  </form>
{{else}}
  <p class="text-muted">Estas son las citas que tienes asignadas para acompañar a un interno.</p>
{{/if}}

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        {{#if veTodas}}<th>#</th>{{/if}}
        <th>Interno</th>
        <th>Especialidad</th>
        {{#if veTodas}}<th>Estado</th>{{/if}}
        <th>Cita</th>
        <th>Especialista</th>
        {{#if veTodas}}<th>Enfermero</th>{{/if}}
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each lista}}
        <tr>
          {{#if ../veTodas}}<td>{{id_solicitud}}</td>{{/if}}
          <td>
            {{interno_nombre}}
            <div class="small text-muted">{{interno_edad}} años</div>
          </td>
          <td>
            {{especialidad_requerida}}
            {{#if es_externa}}<span class="badge text-bg-light border">Externa</span>{{/if}}
          </td>
          {{#if ../veTodas}}
            <td><span class="badge {{clase_estado}}">{{estado}}</span></td>
          {{/if}}
          <td>{{#if fecha_cita_texto}}{{fecha_cita_texto}}{{else}}—{{/if}}</td>
          <td>{{#if especialista_nombre}}{{especialista_nombre}}{{else}}—{{/if}}</td>
          {{#if ../veTodas}}
            <td>
              {{#if falta_enfermero}}
                <span class="badge text-bg-warning">Sin enfermero</span>
              {{else}}
                {{#if enfermero_nombre}}{{enfermero_nombre}}{{else}}—{{/if}}
              {{/if}}
            </td>
          {{/if}}
          <td class="text-end">
            <a href="/solicitudes/{{id_solicitud}}" class="btn btn-sm btn-outline-primary">Ver</a>
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="8" class="text-center text-muted py-4">
            {{#if veTodas}}No hay solicitudes.{{else}}No tienes acompañamientos asignados.{{/if}}
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<p class="text-muted small">{{lista.length}} solicitud(es).</p>
