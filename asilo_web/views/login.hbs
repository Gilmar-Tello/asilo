<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Asilo Cabeza de Algodón</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/login.css">
    </head>
    <body>
        <div class="contenedor-login">
            {{#if error}}
            <div class="alert alert-danger">{{error}}</div>
            {{/if}}

            <!--el formulario al lado izquiero-->
            <div class="lado-formulario">
                <div class="caja-login">
                    <form action="/login" method="POST">
                        <input type="text" name="usuario" placeholder="Usuario" required>
                        <input type="password" name="clave" placeholder="Contraseña" required>
                        <button type="submit" class="btn-login">Ingresar</button>
                        <a href="/recuperar" class="link-olvido">¿Olvido su contraseña</a>
                        <hr>
                    </form>
                </div>
            </div>

            <!--texto al lado derecho-->
            <div class="lado-texto">
                <h1>ASILO DE ANCIANOS<br>CABEZA DE ALGODON</h1>
                <p>Mazatenango, Suchitepequez</p>
            </div>
        </div>
    </body>
</html>
