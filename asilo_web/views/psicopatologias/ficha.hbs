<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0">Padecimientos</h2>
    <div class="text-muted">
      {{interno.nombre_completo}} · DPI {{interno.dpi}} · {{interno.edad}} años
    </div>
  </div>
  <a href="/padecimientos" class="btn btn-outline-secondary">Volver a la lista</a>
</div>

{{#if mensaje}}
  <div class="alert alert-{{tipo}}">{{mensaje}}</div>
{{/if}}

{{#if (puede 'psicopatologias:crear')}}
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">Registrar padecimiento</h5>
      <form class="row g-2" action="/padecimientos/interno/{{interno.id_interno}}" method="POST">
        <div class="col-12 col-md-6">
          <label for="nombre_padecimiento" class="form-label">Padecimiento *</label>
          <input type="text" class="form-control" id="nombre_padecimiento"
                 name="nombre_padecimiento" required minlength="3" maxlength="150"
                 value="{{form.nombre_padecimiento}}">
        </div>
        <div class="col-12 col-md-6">
          <label for="medicamento_cajon" class="form-label">Medicamento de cajón</label>
          <input type="text" class="form-control" id="medicamento_cajon"
                 name="medicamento_cajon" maxlength="150" value="{{form.medicamento_cajon}}">
        </div>
        <div class="col-12 col-md-6">
          <label for="dosis" class="form-label">Dosis</label>
          <input type="text" class="form-control" id="dosis" name="dosis"
                 maxlength="100" value="{{form.dosis}}">
        </div>
        <div class="col-12 col-md-6">
          <label for="descripcion" class="form-label">Descripción</label>
          <input type="text" class="form-control" id="descripcion" name="descripcion"
                 maxlength="1000" value="{{form.descripcion}}">
        </div>
        <div class="col-12">
          <button type="submit" class="btn btn-primary">Guardar padecimiento</button>
        </div>
      </form>
    </div>
  </div>
{{/if}}

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Fecha</th>
        <th>Padecimiento</th>
        <th>Medicamento</th>
        <th>Dosis</th>
        <th>Descripción</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each padecimientos}}
        <tr {{#if anulada}}class="text-muted"{{/if}}>
          <td>{{fecha_texto}}</td>
          <td>
            {{#if anulada}}<s>{{nombre_padecimiento}}</s> <span class="badge text-bg-secondary">Anulado</span>
            {{else}}{{nombre_padecimiento}}{{/if}}
          </td>
          <td>{{medicamento_cajon}}</td>
          <td>{{dosis}}</td>
          <td>{{descripcion}}</td>
          <td class="text-end">
            {{#unless anulada}}
              {{#if (puede 'psicopatologias:anular')}}
                <form action="/padecimientos/{{id_psicopatologia}}/anular" method="POST" class="d-inline"
                      onsubmit="return confirm('¿Anular este padecimiento? Quedará en el historial como anulado.');">
                  <button class="btn btn-sm btn-outline-danger">Anular</button>
                </form>
              {{/if}}
            {{/unless}}
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="6" class="text-center text-muted py-4">
            Este interno todavía no tiene padecimientos registrados.
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<p class="text-muted small">
  Los padecimientos no se borran: si hubo un error se anulan y se registra el correcto.
  Para derivar a un interno con una solicitud de referencia hace falta al menos un padecimiento vigente.
</p>
