<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{titulo}} - Asilo de Ancianos Cabeza de Algodón</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body class="cuerpo-sistema">

  <nav class="navbar px-4 barra-superior">
    <button class="navbar-toggler d-md-none" type="button"
            data-bs-toggle="offcanvas" data-bs-target="#menuLateral">
      <span class="navbar-toggler-icon"></span>
    </button>
    <span class="navbar-brand mb-0 h1 text-white">Asilo de Ancianos Cabeza de Algodón</span>
    <div class="text-white">
      {{usuario}} ({{rol}})
      <a href="/logout" class="btn btn-light btn-sm ms-3">Cerrar sesión</a>
    </div>
  </nav>

  <div class="container-fluid contenedor-sistema">
    <div class="row">

      {{> menu}}

      <div class="col-md-9 col-lg-10 p-4 contenido-principal">

        {{{body}}}

      </div>   <!-- cierra col de contenido -->

    </div>     <!-- cierra row -->
  </div>       <!-- cierra container-fluid -->

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Regla del proyecto: todo texto que se escribe se convierte a MAYÚSCULAS -->
  <script src="/js/mayusculas.js"></script>

</body>
</html>
