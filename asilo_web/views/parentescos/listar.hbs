<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Parentescos</h2>
  {{#if (puede 'parentescos:crear')}}
    <a href="/parentescos/crear" class="btn btn-primary">+ Nuevo parentesco</a>
  {{/if}}
</div>

{{#if mensaje}}
  <div class="alert alert-{{tipo}}">{{mensaje}}</div>
{{/if}}

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Parentesco</th>
        <th>Internos</th>
        <th>Estado</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each lista}}
        <tr>
          <td>{{nombre}}</td>
          <td>{{total_internos}}</td>
          <td>
            {{#if (eq estado 1)}}
              <span class="badge text-bg-success">Activo</span>
            {{else}}
              <span class="badge text-bg-secondary">Inactivo</span>
            {{/if}}
          </td>
          <td class="text-end">
            {{#if (puede 'parentescos:editar')}}
              <a href="/parentescos/editar/{{id_parentesco}}"
                 class="btn btn-sm btn-outline-primary">Editar</a>
            {{/if}}

            {{#if (puede 'parentescos:cambiar_estado')}}
              <form action="/parentescos/estado/{{id_parentesco}}" method="POST" class="d-inline"
                    onsubmit="return confirm('¿Seguro que deseas cambiar el estado de este parentesco?');">
                {{#if (eq estado 1)}}
                  <button class="btn btn-sm btn-outline-secondary">Desactivar</button>
                {{else}}
                  <button class="btn btn-sm btn-outline-success">Activar</button>
                {{/if}}
              </form>
            {{/if}}

            {{#if (puede 'parentescos:eliminar')}}
              <form action="/parentescos/eliminar/{{id_parentesco}}" method="POST" class="d-inline"
                    onsubmit="return confirm('¿Eliminar este parentesco? Esta acción no se puede deshacer.');">
                <button class="btn btn-sm btn-outline-danger"
                  {{#if total_internos}}disabled title="Hay internos con este parentesco; desactívalo en su lugar"{{/if}}>
                  Eliminar
                </button>
              </form>
            {{/if}}
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="4" class="text-center text-muted py-4">No hay parentescos registrados.</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<p class="text-muted small">
  Un parentesco desactivado deja de ofrecerse al registrar internos; quienes ya lo tienen lo conservan.
  Un parentesco en uso no se puede eliminar.
</p>