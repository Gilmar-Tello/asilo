<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0">Visitas médicas</h2>
    <div class="text-muted">Historial de las visitas de los especialistas de la Fundación</div>
  </div>
</div>

{{#if mensaje}}
  <div class="alert alert-{{tipo}}">{{mensaje}}</div>
{{/if}}

<form class="row g-2 mb-3" action="/visitas" method="GET">
  <div class="col-12 col-md-6">
    <input type="text" class="form-control" name="q" value="{{busqueda}}"
           placeholder="Buscar por nombre del interno o diagnóstico" maxlength="100">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
    {{#if busqueda}}<a href="/visitas" class="btn btn-link">Limpiar</a>{{/if}}
  </div>
</form>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Fecha</th>
        <th>Interno</th>
        <th>Especialista</th>
        <th>Estado</th>
        <th>Costo</th>
        <th class="text-end">Total</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each lista}}
        <tr>
          <td>{{fecha_texto}}</td>
          <td>{{interno_nombre}}</td>
          <td>{{especialista_nombre}}{{#if especialidad}}<div class="small text-muted">{{especialidad}}</div>{{/if}}</td>
          <td><span class="badge {{clase_estado}}">{{estado}}</span></td>
          <td><span class="badge {{clase_costo}}">{{estado_costo}}</span></td>
          <td class="text-end">{{#if total}}Q {{total}}{{else}}—{{/if}}</td>
          <td class="text-end">
            <a href="/visitas/{{id_visita}}" class="btn btn-sm btn-outline-primary">Ver</a>
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="7" class="text-center text-muted py-4">No hay visitas registradas.</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>
