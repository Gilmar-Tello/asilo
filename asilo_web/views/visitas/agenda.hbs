<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0">Mi agenda de visitas</h2>
    <div class="text-muted">Citas programadas por la Fundación a tu nombre</div>
  </div>
</div>

{{#if mensaje}}
  <div class="alert alert-{{tipo}}">{{mensaje}}</div>
{{/if}}

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Fecha y hora</th>
        <th>Interno</th>
        <th>Edad</th>
        <th>Especialidad</th>
        <th>Estado de la cita</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each citas}}
        <tr>
          <td><strong>{{fecha_cita_texto}}</strong></td>
          <td>{{interno_nombre}}</td>
          <td>{{interno_edad}} años</td>
          <td>{{especialidad_requerida}}</td>
          <td>
            <span class="badge text-bg-success">{{estado}}</span>
            {{#if id_borrador}}<span class="badge text-bg-warning">Borrador guardado</span>{{/if}}
          </td>
          <td class="text-end">
            <a href="/visitas/atender/{{id_solicitud}}" class="btn btn-sm btn-primary">
              {{#if id_borrador}}Retomar visita{{else}}Atender{{/if}}
            </a>
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="6" class="text-center text-muted py-4">
            No tienes citas programadas. Cuando la Fundación te asigne una cita aparecerá aquí.
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<h4 class="mt-4">Visitas en curso</h4>
<p class="text-muted small mb-2">Pacientes ya atendidos que esperan resultados o seguimiento. Ciérralas cuando ya no necesiten nada.</p>
<div class="list-group mb-4">
  {{#each enCurso}}
    <a href="/visitas/{{id_visita}}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
      <div>
        <strong>{{interno_nombre}}</strong> <span class="small text-muted">· atendido el {{fecha_texto}}</span>
        <div class="small">{{diagnostico}}</div>
      </div>
      <div class="text-end">
        {{#if examenes_pendientes}}<span class="badge text-bg-warning">{{examenes_pendientes}} examen(es) esperando resultado</span>{{/if}}
        {{#if examenes_con_resultado}}<span class="badge text-bg-success">{{examenes_con_resultado}} resultado(s) listo(s)</span>{{/if}}
      </div>
    </a>
  {{else}}
    <div class="list-group-item text-muted">No tienes visitas en curso.</div>
  {{/each}}
</div>

<p class="text-muted small">
  Solo puedes registrar la visita de una cita programada a tu nombre. Al confirmarla, la solicitud queda como "Atendida".
</p>
