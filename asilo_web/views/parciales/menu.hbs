<div class="col-md-3 col-lg-2 offcanvas-md offcanvas-start p-3 menu-lateral"
     tabindex="-1" id="menuLateral">

  <div class="offcanvas-header">
    <h5 class="offcanvas-title">Menú</h5>
    <button type="button" class="btn-close d-md-none"
            data-bs-dismiss="offcanvas" data-bs-target="#menuLateral"></button>
  </div>

  <div class="offcanvas-body">
    <ul class="nav flex-column">

      {{!-- Cada opción aparece solo si el rol del usuario tiene el permiso.
            El administrador (rol de sistema) ve todo. --}}
      {{#if (puede 'usuarios:ver' 'roles:gestionar' 'internos:ver' 'familiares:ver' 'parentescos:ver' 'especialidades:ver')}}
        <li class="nav-item mt-2">
          <span class="text-uppercase small fw-bold text-secondary px-3">Administración</span>
        </li>

        {{#if (puede 'usuarios:ver')}}
          <li class="nav-item"><a class="nav-link" href="/usuarios">Usuarios del sistema</a></li>
        {{/if}}
        {{#if (puede 'roles:gestionar')}}
          <li class="nav-item"><a class="nav-link" href="/roles">Roles y permisos</a></li>
        {{/if}}
        {{#if (puede 'internos:ver')}}
          <li class="nav-item"><a class="nav-link" href="/internos">Internos</a></li>
        {{/if}}
        {{#if (puede 'familiares:ver')}}
          <li class="nav-item"><a class="nav-link" href="/familiares">Familiares responsables</a></li>
        {{/if}}
        {{#if (puede 'parentescos:ver')}}
          <li class="nav-item"><a class="nav-link" href="/parentescos">Parentescos</a></li>
        {{/if}}
        {{#if (puede 'especialidades:ver')}}
          <li class="nav-item"><a class="nav-link" href="/especialidades">Especialidades</a></li>
        {{/if}}
      {{/if}}

      {{#if (puede 'solicitudes:ver' 'solicitudes:ver_asignadas')}}
        <li class="nav-item mt-2">
          <a class="nav-link" href="/solicitudes">
            {{#if (puede 'solicitudes:ver')}}Solicitudes{{else}}Mis acompañamientos{{/if}}
          </a>
        </li>
      {{/if}}

      {{#if (puede 'psicopatologias:ver')}}
        <li class="nav-item mt-2">
          <a class="nav-link" href="/padecimientos">Padecimientos</a>
        </li>
      {{/if}}

      {{#if (puede 'consultas:ver' 'consultas:crear' 'visitas:ver' 'visitas:atender' 'examenes:ver' 'examenes:registrar_resultado')}}
        <li class="nav-item mt-3">
          <span class="text-uppercase small fw-bold text-secondary px-3">Atención médica</span>
        </li>
        {{#if (puede 'consultas:ver' 'consultas:crear')}}
          <li class="nav-item"><a class="nav-link" href="/consultas">Consultas del médico general</a></li>
        {{/if}}
        {{#if (puede 'visitas:atender')}}
          <li class="nav-item"><a class="nav-link" href="/visitas/agenda">Mi agenda de visitas</a></li>
        {{/if}}
        {{#if (puede 'visitas:ver')}}
          <li class="nav-item"><a class="nav-link" href="/visitas">Visitas médicas</a></li>
        {{/if}}
        {{#if (puede 'examenes:ver' 'examenes:registrar_resultado')}}
          <li class="nav-item"><a class="nav-link" href="/examenes">Exámenes de laboratorio</a></li>
        {{/if}}
      {{/if}}

      {{#if (puede 'medicamentos:ver' 'medicamentos:gestionar' 'medicamentos:despachar')}}
        <li class="nav-item mt-3">
          <span class="text-uppercase small fw-bold text-secondary px-3">Farmacia</span>
        </li>
        {{#if (puede 'medicamentos:despachar')}}
          <li class="nav-item"><a class="nav-link" href="/farmacia">Despachar (POS)</a></li>
        {{/if}}
        {{#if (puede 'medicamentos:ver' 'medicamentos:gestionar')}}
          <li class="nav-item"><a class="nav-link" href="/medicamentos">Medicamentos e inventario</a></li>
        {{/if}}
        <li class="nav-item"><a class="nav-link" href="/farmacia/despachos">Despachos</a></li>
      {{/if}}

      {{#if (puede 'finanzas:ver' 'finanzas:cobrar' 'finanzas:registrar')}}
        <li class="nav-item mt-3">
          <span class="text-uppercase small fw-bold text-secondary px-3">Finanzas</span>
        </li>
        <li class="nav-item"><a class="nav-link" href="/finanzas/caja">Caja (entradas y salidas)</a></li>
        <li class="nav-item"><a class="nav-link" href="/finanzas/cuentas">Cuentas de familiares</a></li>
        <li class="nav-item"><a class="nav-link" href="/finanzas/cuotas">Cuotas mensuales</a></li>
        <li class="nav-item"><a class="nav-link" href="/finanzas/donaciones">Donaciones</a></li>
        <li class="nav-item"><a class="nav-link" href="/finanzas/facturacion">Facturación</a></li>
        <li class="nav-item"><a class="nav-link" href="/finanzas/fundacion">Pagos a la Fundación</a></li>
      {{/if}}

      {{#if (puede 'reportes:ver')}}
        <li class="nav-item mt-3">
          <span class="text-uppercase small fw-bold text-secondary px-3">Reportes</span>
        </li>
        <li class="nav-item"><a class="nav-link" href="/reportes">Reportes e informes</a></li>
      {{/if}}

      {{#if (puede 'correos:ver' 'correos:configurar')}}
        <li class="nav-item mt-3">
          <span class="text-uppercase small fw-bold text-secondary px-3">Notificaciones</span>
        </li>
        <li class="nav-item"><a class="nav-link" href="/correos">Correos a familiares</a></li>
        {{#if (puede 'correos:configurar')}}
          <li class="nav-item"><a class="nav-link" href="/correos/plantillas">Plantillas de correo</a></li>
        {{/if}}
      {{/if}}

    </ul>
  </div>

</div>
