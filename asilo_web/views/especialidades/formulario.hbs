<form class="formulario" action="{{accion}}" method="POST">
  <h2>{{tituloForm}}</h2>

  {{#if mensaje}}
    <div class="alert alert-danger">{{mensaje}}</div>
  {{/if}}

  <fieldset>
    <legend>Datos de la especialidad</legend>

    <div class="fila">
      <div class="grupo">
        <label for="nombre">Nombre *</label>
        <input type="text" id="nombre" name="nombre" required
               minlength="3" maxlength="50"
               placeholder="Ejemplo: Medicina interna" value="{{especialidadForm.nombre}}">
      </div>
    </div>
  </fieldset>

  <button type="submit">Guardar especialidad</button>
  <p class="nota"><a href="/especialidades">Cancelar y volver a la lista</a></p>
</form>
