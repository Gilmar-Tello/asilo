<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Internos</h2>
  {{#if (puede 'internos:crear')}}
    <a href="/internos/crear" class="btn btn-primary">+ Nuevo interno</a>
  {{/if}}
</div>

{{#if mensaje}}
  <div class="alert alert-{{tipo}}">{{mensaje}}</div>
{{/if}}

<form class="row g-2 mb-4" action="/internos" method="GET">
  <div class="col-12 col-md-6">
    <input type="text" name="busqueda" class="form-control"
           placeholder="Buscar por nombre, DPI o familiar responsable"
           value="{{busqueda}}">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
  </div>
  {{#if busqueda}}
    <div class="col-auto">
      <a href="/internos" class="btn btn-outline-secondary">Limpiar</a>
    </div>
  {{/if}}
</form>

<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Nombre completo</th>
        <th>DPI</th>
        <th>Edad</th>
        <th>Ingreso</th>
        <th>Familiar responsable</th>
        <th>Estado</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each lista}}
        <tr>
          <td>{{nombre_completo}}</td>
          <td>{{dpi}}</td>
          <td>{{edad}} años</td>
          <td>{{fecha_ingreso_texto}}</td>
          <td>
            {{familiar}}
            <div class="small text-muted">{{parentesco}}</div>
          </td>
          <td>
            {{#if (eq estado 1)}}
              <span class="badge text-bg-success">Activo</span>
            {{else}}
              <span class="badge text-bg-secondary">Inactivo</span>
            {{/if}}
          </td>
          <td class="text-end">
            {{#if (puede 'psicopatologias:ver')}}
              <a href="/padecimientos/interno/{{id_interno}}"
                 class="btn btn-sm btn-outline-secondary">Padecimientos</a>
            {{/if}}

            {{#if (puede 'internos:editar')}}
              <a href="/internos/editar/{{id_interno}}"
                 class="btn btn-sm btn-outline-primary">Editar</a>
            {{/if}}

            {{#if (puede 'internos:cambiar_estado')}}
              <form action="/internos/estado/{{id_interno}}" method="POST" class="d-inline"
                    onsubmit="return confirm('¿Seguro que deseas cambiar el estado de este interno?');">
                {{#if (eq estado 1)}}
                  <button class="btn btn-sm btn-outline-danger">Desactivar</button>
                {{else}}
                  <button class="btn btn-sm btn-outline-success">Activar</button>
                {{/if}}
              </form>
            {{/if}}
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="7" class="text-center text-muted py-4">
            No se encontraron internos.
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<p class="text-muted small">{{lista.length}} interno(s) encontrado(s).</p>