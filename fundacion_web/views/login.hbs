<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fundación - Iniciar sesión</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <!-- Mismo diseño de inicio de sesión que el asilo -->
  <link rel="stylesheet" href="/css/login.css">
  <style>
    .aviso-error { background: #f8d7da; color: #842029; border-radius: 6px; padding: 12px 14px; margin-bottom: 12px; font-size: 15px; }
  </style>
</head>
<body>
  <div class="contenedor-login">

    <!-- Formulario a la izquierda -->
    <div class="lado-formulario">
      <div class="caja-login">
        {{#if error}}<div class="aviso-error">{{error}}</div>{{/if}}
        <form action="/login" method="POST">
          <input type="text" name="usuario" placeholder="Usuario" required autofocus>
          <input type="password" name="clave" placeholder="Contraseña" required>
          <button type="submit" class="btn-login">Ingresar</button>
          <hr>
        </form>
      </div>
    </div>

    <!-- Texto a la derecha -->
    <div class="lado-texto">
      <h1>FUNDACIÓN</h1>
      <p>Referencias de especialistas del<br>Asilo de Ancianos Cabeza de Algodón</p>
    </div>
  </div>
</body>
</html>
