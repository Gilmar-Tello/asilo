<h2 class="mb-4">Referencias recibidas del asilo</h2>

<form class="row g-2 mb-4" action="/referencias" method="GET">
  <div class="col-12 col-md-4">
    <select name="estado" class="form-select">
      <option value="">Todos los estados</option>
      {{#each estados}}
        <option value="{{this}}" {{#if (eq this ../estado)}}selected{{/if}}>{{this}}</option>
      {{/each}}
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-success">Filtrar</button>
  </div>
  {{#if estado}}
    <div class="col-auto">
      <a href="/referencias" class="btn btn-outline-secondary">Limpiar</a>
    </div>
  {{/if}}
</form>

<div class="table-responsive">
  <table class="table table-hover align-middle bg-white">
    <thead class="table-light">
      <tr>
        <th>Código</th>
        <th>Interno</th>
        <th>Especialidad</th>
        <th>Estado</th>
        <th>Cita</th>
        <th>Especialista</th>
        <th>Recibida</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each lista}}
        <tr>
          <td>{{codigo}}</td>
          <td>
            {{interno_nombre}}
            {{#if interno_edad}}<div class="small text-muted">{{interno_edad}} años</div>{{/if}}
          </td>
          <td>
            {{especialidad}}
            {{#if es_externa}}<span class="badge text-bg-light border">Externa</span>{{/if}}
          </td>
          <td><span class="badge {{clase_estado}}">{{estado}}</span></td>
          <td>{{#if fecha_cita_texto}}{{fecha_cita_texto}}{{else}}—{{/if}}</td>
          <td>{{#if especialista_nombre}}{{especialista_nombre}}{{else}}—{{/if}}</td>
          <td class="small text-muted">{{fecha_recepcion_texto}}</td>
          <td class="text-end">
            <a href="/referencias/{{codigo}}"
               class="btn btn-sm {{#if requiere_atencion}}btn-success{{else}}btn-outline-secondary{{/if}}">
              {{#if requiere_atencion}}Atender{{else}}Ver{{/if}}
            </a>
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="8" class="text-center text-muted py-4">No hay referencias.</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<p class="text-muted small">{{lista.length}} referencia(s).</p>
